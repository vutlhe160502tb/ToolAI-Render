# Backend .env.example — KHÔNG chứa secret thật

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_dancing

# Backend config
BACKEND_URL=http://localhost:8000
# Frontend base URL for referral link (deploy: set to your app domain, e.g. https://your-app.up.railway.app)
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-strong-secret
ENV=development

# SePay (BẮT BUỘC nếu dùng payment)
SEPAY_API_URL=https://qr-moniter.up.railway.app
CLIENT_WEBHOOK_URL=http://localhost:8000/api/payments/webhook
WEBHOOK_SECRET_KEY=replace-with-webhook-secret

# Optional
PAYMENT_TIMEOUT_MINUTES=30

# Google OAuth (optional)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# NextAuth (optional)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-secret-32+chars

