# =========================================
# env.example (template) — KHÔNG chứa secret thật
# Copy các phần tương ứng vào:
# - backend/.env
# - frontend/.env.local (hoặc frontend/.env)
# =========================================

# -------------------------
# FRONTEND (Next.js) — frontend/
# -------------------------

# URL backend để Next.js gọi API
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# NextAuth (user login Google)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-secret-32+chars
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Admin tách riêng (cookie session) — /surrealAdmin
SURREAL_ADMIN_USER=surrealAdmin
SURREAL_ADMIN_PASSWORD=Lynx@12345
SURREAL_ADMIN_COOKIE_SECRET=replace-with-strong-random-secret


# -------------------------
# BACKEND (FastAPI) — backend/
# -------------------------

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_dancing

# Backend config
BACKEND_URL=http://localhost:8000
SECRET_KEY=replace-with-strong-secret
ENV=development

# SePay (BẮT BUỘC nếu dùng payment)
SEPAY_API_URL=https://qr-moniter.up.railway.app
CLIENT_WEBHOOK_URL=http://localhost:8000/api/payments/webhook
WEBHOOK_SECRET_KEY=replace-with-webhook-secret

# Optional
PAYMENT_TIMEOUT_MINUTES=30

# Google OAuth (nếu backend cần)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

