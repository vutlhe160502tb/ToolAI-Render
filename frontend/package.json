{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "node -e \"const fs=require('fs');['.next','.turbo','.swc'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});console.log('Removed',d)}catch(e){}});require('child_process').exec('find . -name \\\"*.tsbuildinfo\\\" -delete',()=>{})\"",
    "clean:all": "npm run clean && rm -rf node_modules",
    "fresh": "npm run clean:all && npm install"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
